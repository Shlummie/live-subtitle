<Window x:Class="LiveSubtitle.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveSubtitle overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="Height" Width="900"
        AutomationProperties.Name="Live subtitle overlay">
    <Grid MouseLeftButtonDown="OnMouseLeftButtonDown">
        <Border x:Name="OverlaySurface" Margin="20" Padding="18,12" CornerRadius="12" BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="#49D493" VerticalAlignment="Center" Margin="0,0,7,0" Opacity="0.3">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Opacity" Value="0.3"/><Style.Triggers><DataTrigger Binding="{Binding IsListening}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="LIVE SUBTITLE" Foreground="#C7D3E4" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="EDIT MODE" Foreground="#FFD98A" FontSize="9" FontWeight="Bold" Visibility="{Binding OverlayLocked, Converter={StaticResource InverseBoolToVisibility}}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding OverlayCaptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,4">
                                <TextBlock Text="{Binding SourceLabel}" Foreground="{Binding SourceColorHex, Converter={StaticResource HexBrush}}" FontSize="10" FontWeight="Bold"
                                           Visibility="{Binding DataContext.ShowSourceLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock x:Name="CaptionText" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight"
                                           FontFamily="{Binding DataContext.OverlayFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="{Binding DataContext.OverlayFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="{Binding DataContext.OverlayFontWeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontWeight}}"
                                           Foreground="{Binding DataContext.OverlayTextColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexBrush}}">
                                    <Run Text="{Binding StableText, Mode=OneWay}"/><Run Text=" "/><Run x:Name="DraftRun" Text="{Binding ProvisionalText, Mode=OneWay}" Foreground="{Binding DataContext.OverlayDraftColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexBrush}}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Waiting for speech…" Foreground="#AAB6C5" FontSize="15" Margin="0,2,0,3">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OverlayCaptions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
        <ResizeGrip Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                    Focusable="False" Visibility="{Binding OverlayLocked, Converter={StaticResource InverseBoolToVisibility}}"/>
    </Grid>
</Window>
