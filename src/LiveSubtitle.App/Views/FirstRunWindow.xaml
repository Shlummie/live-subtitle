<Window x:Class="LiveSubtitle.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LiveSubtitle.App.Controls"
        Title="Welcome to LiveSubtitle" Width="820" Height="610" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/LiveSubtitle.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.Name="LiveSubtitle first-run setup">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Set up LiveSubtitle" FontFamily="{DynamicResource DisplayFont}" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="StepLabel" Grid.Column="1" Text="1 of 4" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>
        <ProgressBar Grid.Row="0" Value="25" Maximum="100" Height="3" VerticalAlignment="Bottom" Margin="0,42,0,0" x:Name="Progress"/>

        <Grid Grid.Row="1" Margin="0,30,0,20">
            <Grid x:Name="PrivacyPage">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="12,0,30,0">
                    <TextBlock Text="Live captions, kept local" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="LiveSubtitle listens only after you start it. Speech recognition runs on this PC, audio stays in bounded memory, and no account or telemetry is used." Style="{StaticResource BodySecondary}" FontSize="15" LineHeight="23" Margin="0,14,0,0"/>
                    <TextBlock Text="Captions are ephemeral by default" FontWeight="SemiBold" FontSize="16" Margin="0,24,0,5"/>
                    <TextBlock Text="When a listening session ends, its text is erased unless you enabled Save this session." Style="{StaticResource BodySecondary}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SurfaceBorder}" Background="{DynamicResource AccentSubtleBrush}" Padding="24" VerticalAlignment="Center">
                    <StackPanel>
                        <Viewbox Width="58" Height="58" HorizontalAlignment="Left"><Path Data="M4,7 V4 A4,4 0 0 1 12,4 V7 M2,7 H14 V14 H2 Z M8,10 V12" Stroke="{DynamicResource AccentHoverBrush}" StrokeThickness="1.4" Stretch="Uniform"/></Viewbox>
                        <TextBlock Text="Private by construction" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
                        <TextBlock Text="No cloud service&#x0a;No stored raw audio&#x0a;No automatic transcript recording&#x0a;Sanitized logs only" Style="{StaticResource BodySecondary}" LineHeight="25"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ModelPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Download the recommended model" Style="{StaticResource PageTitle}"/>
                        <controls:SettingInfoButton SettingName="Speech model" Description="Larger models can improve accuracy but use more memory and usually run slower. Models are downloaded separately." Margin="9,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Base English is the default balance for this PC. You can switch model tiers later." Style="{StaticResource BodySecondary}" Margin="0,7,0,0"/>
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Margin="0,18,0,10" AutomationProperties.Name="Speech models">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,3"/><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Description}" Style="{StaticResource BodySecondary}"/><ProgressBar Value="{Binding Progress}" Maximum="100" Visibility="{Binding Downloading, Converter={StaticResource BoolToVisibility}}" Margin="0,8,16,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding SizeLabel}" HorizontalAlignment="Right"/><TextBlock Text="{Binding State}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Downloads use pinned HTTPS URLs and are verified before installation." Style="{StaticResource BodySecondary}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Download selected" Command="{Binding DownloadModelCommand}" Style="{StaticResource PrimaryButton}"/></Grid>
            </Grid>

            <Grid x:Name="SourcesPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Choose and test audio sources" Style="{StaticResource PageTitle}"/><TextBlock Text="The default computer output is ready. Add a microphone or application now, or configure them later." Style="{StaticResource BodySecondary}" Margin="0,7,0,0"/></StackPanel>
                <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Margin="0,18,0,12">
                    <ItemsControl ItemsSource="{Binding AudioSources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="150"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding ColorHex, Converter={StaticResource HexBrush}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <controls:SettingInfoButton Grid.Column="2" SettingName="{Binding Label, StringFormat=Audio route for {0}}" Description="Selects the device or application LiveSubtitle listens to for this source." Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.Endpoints, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedEndpoint}" Margin="0,0,14,0" Visibility="{Binding IsProcess, Converter={StaticResource InverseBoolToVisibility}}" ItemContainerStyle="{StaticResource NameComboBoxItem}" AutomationProperties.Name="{Binding Label, StringFormat=Audio endpoint for {0}}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.Processes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedProcess}" Margin="0,0,14,0" Visibility="{Binding IsProcess, Converter={StaticResource BoolToVisibility}}" ItemContainerStyle="{StaticResource DisplayNameComboBoxItem}" AutomationProperties.Name="{Binding Label, StringFormat=Application process for {0}}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ProgressBar Grid.Column="4" Value="{Binding LevelPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"><Button Content="Add microphone" Command="{Binding AddInputSourceCommand}" Margin="0,0,8,0"/><Button Content="Add application" Command="{Binding AddProcessSourceCommand}" Margin="0,0,8,0"/><Button Content="Refresh" Command="{Binding RefreshAudioCommand}" Margin="0,0,8,0"/><Button Content="Test sources for 5 seconds" Command="{Binding TestSourcesCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SourceTestStatus}" Style="{StaticResource BodySecondary}" Margin="0,8,0,0"/>
                </Grid>
            </Grid>

            <Grid x:Name="FinishPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="12,0,32,0">
                    <TextBlock Text="Position and verify" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="The overlay is always on top and safe for desktop, windowed, and borderless-fullscreen apps. Unlock it to drag and resize." Style="{StaticResource BodySecondary}" FontSize="15" LineHeight="23" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Show overlay" Command="{Binding ToggleOverlayCommand}" Margin="0,0,8,0"/><Button Content="{Binding OverlayLockText}" Command="{Binding ToggleOverlayLockCommand}"/></StackPanel>
                    <TextBlock Text="Backend check" FontWeight="SemiBold" FontSize="15" Margin="0,24,0,5"/>
                    <TextBlock Text="{Binding BenchmarkResult}" Style="{StaticResource BodySecondary}"/>
                    <Button Content="Run backend check" Command="{Binding RunBenchmarkCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SurfaceBorder}" VerticalAlignment="Center" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Ready when you are" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Ctrl+Alt+Space" Foreground="{DynamicResource AccentHoverBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,2"/>
                        <TextBlock Text="Start or stop listening" Style="{StaticResource BodySecondary}"/>
                        <TextBlock Text="Ctrl+Alt+O" Foreground="{DynamicResource AccentHoverBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,2"/>
                        <TextBlock Text="Show or hide overlay" Style="{StaticResource BodySecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Skip for now" Click="OnSkip"/>
            <Button Grid.Column="2" x:Name="BackButton" Content="Back" Click="OnBack" Visibility="Collapsed"/>
            <Button Grid.Column="4" x:Name="NextButton" Content="Next" Click="OnNext" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
        </Grid>
    </Grid>
</Window>
